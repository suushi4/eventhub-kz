rules_version = '2'; service cloud.firestore { match /databases/{database}/documents { match /users/{uid}/{document=**} { allow read, write: if request.auth != null && request.auth.uid == uid; } match /events/{eventId} { allow read: if true; allow create: if request.auth != null; allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid; } } }
